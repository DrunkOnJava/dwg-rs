# Cargo build artifacts
/target/
# Nested target/ for out-of-workspace sub-crates (e.g. tools/synthetic-dwg).
**/target/
# Separate CARGO_TARGET_DIR used to verify the MSRV without evicting the
# stable toolchain's incremental cache:
#   CARGO_TARGET_DIR=target-msrv cargo +1.85.0 test --no-run --all-features
/target-msrv/
**/*.rs.bk

# Cargo.lock is committed for reproducibility — this is a binary-producing
# crate so the pinned dependency graph matters for releases.

# Editor / IDE
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
*.pid
*.log

# Coverage
/coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.html

# Profiling
flamegraph.svg
perf.data
perf.data.old

# Proptest regression seeds (commit after narrowing to verify shrinking)
# Comment the next line out to keep reproducible counter-examples.
proptest-regressions/
# Proptest 1.x also writes <test-name>.proptest-regressions next to
# each test file — same exclusion applies.
*.proptest-regressions

# Environment
.env
.env.*
!.env.example

# Local test fixtures (kept outside repo to respect licensing)
/samples/local/
/tests/fixtures/local/

# Repeatable streaming E2E artifacts (uploaded by CI).
/streaming-build/
/streaming-evidence.json
/streaming-schedules-*.jsonl
/walk-evidence.json
/walk-schedules-*.jsonl
/lz77-evidence.json
/lz77-schedules-*.jsonl
/source-evidence.json
/r2004-evidence.json
/r2004-schedules-*.jsonl
/map-evidence.json
/map-schedules-*.jsonl
/sections-evidence.json
/sections-schedules-*.jsonl
/wasm-evidence.json
/file-evidence.json
/file-schedules-*.jsonl
/r2007-evidence.json
/r2007-schedules-*.jsonl
/wasm-r2007-evidence.json
